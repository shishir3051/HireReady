# Express API origin used by server components and the /api rewrite
API_URL=http://localhost:4000

# Optional: hostnames allowed to use the dev server from other devices (e.g. your LAN IP), comma-separated
# DEV_ALLOWED_ORIGINS=192.168.1.20

# Optional: where the pre-recorded English narration clips are served from (see tools/narration/README.md).
# Default: this site's /narration folder (client/public/narration). Read at build time.
# NEXT_PUBLIC_NARRATION_AUDIO_URL=https://<user>.github.io/hireready-narration
