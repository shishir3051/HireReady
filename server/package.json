{
  "name": "hireready-server",
  "version": "1.0.0",
  "description": "HireReady REST API (Express + MongoDB)",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "tsx scripts/seed.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:content-bn": "tsx scripts/validate-content-bn.ts"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true
}
