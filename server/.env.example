NODE_ENV=development
PORT=4000
# URL-encode special characters in the password (e.g. "/" -> %2F, "@" -> %40)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/hireready?appName=Cluster0
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3200
# Only when running behind a reverse proxy you control: true, a hop count ("1"), or names/CIDRs ("loopback")
# TRUST_PROXY=1

# Public URL of the web app (password-reset links and Google sign-in redirects). Defaults to the first CLIENT_ORIGIN.
APP_URL=http://localhost:3200

# Password-reset email via SMTP. Leave SMTP_HOST empty to print reset links in the API console (development only).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Google sign-in: Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini AI: Get an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
